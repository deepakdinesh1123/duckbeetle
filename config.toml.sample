[app]
# log level is one of : INFO, DEBUG, ERROR
log_level = "INFO"
# maximum time allowed for a job to run once it has started execution
default_job_ttl = "60s"

# The broker that manages job queuing.
# Currently, only "redis" is supported.
[job_queue.broker]
type = "redis"
addresses = ["localhost:6379"]
password = ""
db = 1
max_active = 50
max_idle = 20
dial_timeout = "1s"
read_timeout = "1s"
write_timeout = "1s"

# The state store where the state of the jobs in the queue and their
# metadata are maintained.
[job_queue.state]
type = "redis"
addresses = ["localhost:6379"]
password = ""
db = 1
max_active = 50
max_idle = 20
dial_timeout = "1s"
read_timeout = "1s"
write_timeout = "1s"
expiry = "86400s"
meta_expiry = "86400s"

# DuckDB compute engine limits (per worker job)
[duckdb]
threads_per_job = 2
memory_limit_per_job = "2GB"

# DuckLake configuration: Parquet file destination and metadata catalog.
[ducklake]
# Catalog DSN: PostgreSQL or SQLite
catalog = "ducklake:postgres:dbname=ducklake_catalog host=127.0.0.1 user=postgres password=secret port=5432 sslmode=disable"
# Data path where Parquet files will be uploaded (S3 URI or local directory)
data_path = "s3://reports-lakehouse/data/"

# S3 Object Storage Configuration (Optional: leave empty to use IAM / environment credentials)
s3_region = "us-east-1"
s3_endpoint = "s3.amazonaws.com"
s3_use_ssl = true
s3_access_key = ""
s3_secret_key = ""

# Source databases against which SQL queries are executed.
# Currently supported types: "postgres" and "mysql".
[sources.pg_orders]
type = "postgres"
dsn = "dbname=production host=127.0.0.1 user=postgres password=secret port=5432 sslmode=disable"

[sources.mysql_users]
type = "mysql"
dsn = "root:secret@tcp(127.0.0.1:3306)/production"
